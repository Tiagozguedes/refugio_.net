# Copie para .env e preencha (o .env fica fora do Git). Nunca coloque credenciais reais neste arquivo.
#   cp .env.example .env

# Oracle (FIAP)
ORACLE_USUARIO=
ORACLE_SENHA=
ORACLE_DATA_SOURCE=oracle.fiap.com.br:1521/ORCL

# Chave de assinatura do JWT: pelo menos 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
JWT_CHAVE=

# Porta da API no docker-compose
API_PORT=8080

# Senha dos usuários de teste criados pelo seed (gestor@refugio.com, maria@email.com, jose@email.com)
SEED_SENHA_USUARIOS=Senha@123
